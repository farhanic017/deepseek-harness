{
  "name": "@deepseek-ai/dsh-electron",
  "description": "Electron desktop application for DeepSeek Harness",
  "version": "0.8.0",
  "author": "DeepSeek AI",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "apps/electron"
  },
  "type": "module",
  "main": "dist/main/main.cjs",
  "files": [
    "dist/main",
    "dist/preload",
    "resources",
    "scripts",
    "src",
    "tsconfig.json",
    "tsdown.config.ts",
    "README.md"
  ],
  "scripts": {
    "build:web": "pnpm --filter @deepseek-ai/dsh-web-frontend build",
    "resolve:node-modules": "node scripts/resolve-node-modules.cjs",
    "build": "npm run build:web && tsc -p tsconfig.json && tsdown && node scripts/fix-main.cjs",
    "build:unpacked": "npm run build && node scripts/materialize-workspace.cjs && electron-builder --dir -mwl",
    "build:all": "npm run build && node scripts/materialize-workspace.cjs && electron-builder -mwl",
    "dev": "npm run build:web && concurrently -k \"tsc -w -p tsconfig.json\" \"tsdown --watch\" \"wait-on dist/main/main.cjs && electron .\"",
    "dist": "npm run build && node scripts/materialize-workspace.cjs && electron-builder -mwl"
  },
  "license": "MIT",
