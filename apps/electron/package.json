  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.31",
    "@types/react-dom": "~18.3.7",
    "concurrently": "^9.0.0",
    "electron": "^39.0.0",
    "electron-builder": "^25.0.0",
    "tsdown": "^0.3.0",
    "typescript": "^6.0.3",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "ai.deepseek.dsh",
    "productName": "DeepSeek Harness",
    "beforeBuild": "./scripts/skip-node-modules.cjs",
    "copyright": "Copyright © 2024 DeepSeek AI",
    "asar": true,
    "directories": {
      "output": "dist/installer",
      "buildResources": "resources"
    },
    "files": [
      "dist/main/**/*",
      "dist/preload/**/*",
      "dist/renderer/**/*",
      "resources/**/*"
    ],
    "extraResources": [
      {
        "from": "../cli/config/agent-presets",
        "to": "workspace/config-agent-presets",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "C:/Users/Farhan/AppData/Local/Programs/DeepSeek Harness/resources/workspace",
        "to": "workspace",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.icns"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "linux": {
      "target": [
        {
          "target": "tar.gz",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "resources/icon.png",
      "category": "Development",
      "maintainer": "DeepSeek AI <support@deepseek.ai>",
      "synopsis": "DeepSeek Harness - AI Coding Agent",
      "description": "DeepSeek Harness is a desktop AI coding agent that helps you write, review, and debug code."
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico"
    }
  }
}
